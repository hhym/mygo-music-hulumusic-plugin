{
  "id": "hulu-music",
  "name": "葫芦音源",
  "version": "1.2.3",
  "minAppVersion": "0.1.8",
  "main": "index.js",
  "playback": "stream",
  "permissions": {
    "network": [
      "music.163.com",
      "*.126.net",
      "*.163.com",
      "search.kuwo.cn",
      "antiserver.kuwo.cn",
      "*.kuwo.cn",
      "*.youtube.com",
      "*.ytimg.com",
      "*.googlevideo.com",
      "*.googleapis.com",
      "lrclib.net",
      "github.com",
      "objects.githubusercontent.com",
      "release-assets.githubusercontent.com",
      "api.bilibili.com",
      "*.bilibili.com",
      "*.bilivideo.com",
      "*.bilivideo.cn",
      "*.mcdn.bilivideo.cn",
      "*.hdslb.com",
      "*.jsdelivr.net",
      "*.qtfm.cn",
      "lhttp.qtfm.cn",
      "stream.zeno.fm",
      "*.zeno.fm",
      "podtown.xyz",
      "*.myqcloud.com",
      "*.fireside.fm",
      "*.xyzfm.space",
      "*.xyzcdn.net",
      "raw.githubusercontent.com",
      "c.y.qq.com",
      "u.y.qq.com",
      "y.qq.com",
      "*.qq.com",
      "*.gtimg.cn",
      "itunes.apple.com",
      "*.apple.com",
      "feed.xyzfm.space",
      "*.xiaoyuzhoufm.com",
      "*.xyzcdn.net",
      "*.ximalaya.com",
      "*.libsyn.com",
      "*.simplecast.com",
      "*.megaphone.fm",
      "*.acast.com",
      "*.buzzsprout.com",
      "*.podbean.com",
      "*.typlog.io",
      "*.anchor.fm",
      "icecast.radiofrance.fr",
      "*.radiofrance.fr",
      "ice1.somafm.com",
      "*.somafm.com",
      "stream-relay-geo.ntslive.net",
      "*.ntslive.net",
      "stream.radioparadise.com",
      "*.radioparadise.com",
      "media-ice.musicradio.com",
      "s5-webradio.antenne.de",
      "roamdial.com",
      "images.weserv.nl",
      "*.antenne.de"
    ],
    "process": [
      "bin/win32-amd64/ffmpeg.exe",
      "bin/win32-arm64/ffmpeg.exe",
      "bin/darwin-arm64/ffmpeg",
      "bin/darwin-amd64/ffmpeg",
      "bin/linux-amd64/ffmpeg",
      "bin/linux-arm64/ffmpeg",
      "powershell",
      "pwsh",
      "/bin/sh",
      "ffmpeg",
      "ffmpeg.exe",
      "/opt/homebrew/bin/ffmpeg",
      "/usr/local/bin/ffmpeg",
      "/usr/bin/ffmpeg",
      "/snap/bin/ffmpeg",
      "C:\\ffmpeg\\bin\\ffmpeg.exe",
      "C:\\Program Files\\ffmpeg\\bin\\ffmpeg.exe"
    ]
  },
  "settings": [
    {
      "key": "proxyMode",
      "label": "代理地址",
      "help": "留空默认 127.0.0.1:7890，不使用填 0，填写后以地址为准"
    },
    {
      "key": "transcode",
      "label": "转码播放",
      "help": "留空或填 1 = 开启：HE-AAC（SBR）、MPEG Layer II、HLS 等播放器解不了的内容会用本机 ffmpeg 实时转 mp3。填 0 关闭：直接播原地址，多数这类内容会报 go-aac/SBR 或 only layer3 错误。"
    },
    {
      "key": "ffmpegPath",
      "label": "ffmpeg 路径",
      "help": "留空则自动查找：先插件自带 bin/，再按 PATH，再试 /opt/homebrew/bin、/usr/local/bin、/usr/bin、/snap/bin、C:\\ffmpeg\\bin 等常见位置。自定义时填完整路径，例如 C:\\ffmpeg\\bin\\ffmpeg.exe 或 /opt/homebrew/bin/ffmpeg",
      "link": "https://ffmpeg.org/download.html"
    }
  ],
  "navigation": [
    {
      "builtin": "home"
    },
    {
      "builtin": "liked",
      "title": "我喜欢"
    },
    {
      "title": "我的歌单",
      "page": "mylists",
      "icon": "playlist"
    },
    {
      "title": "最近播放",
      "page": "recent",
      "icon": "calendar"
    },
    {
      "title": "艺人收藏",
      "page": "artists",
      "icon": "artist"
    },
    {
      "title": "电台",
      "page": "stations",
      "icon": "radio"
    },
    {
      "title": "播客",
      "page": "shows",
      "icon": "podcast"
    },
    {
      "title": "播客收藏",
      "page": "myshows",
      "icon": "heart"
    },
    {
      "title": "QQ 音乐",
      "page": "qq",
      "icon": "chart"
    }
  ],
  "description": "聚合网易云、YouTube、B站、酷我、QQ 与播客/电台的音源插件，多平台互备"
}
