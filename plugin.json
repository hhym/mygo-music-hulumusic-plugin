  "settings": [
    {
      "key": "4c44-music.cookie",
      "label": "世纪音乐 · Cookie (optional)",
      "help": "Only if automatic verification fails: open www.4c44.com in a browser, pass the check, then copy the whole Cookie header from DevTools and paste it here.",
      "type": "text"
    },
    {
      "key": "5nd-music.browser",
      "label": "5nd音乐 · 音频被拒时用浏览器打开",
      "help": "插件已内置一枚 mpge.5nd.com 认的统计 Cookie，App 内通常能直接播。只有在当前网络仍被 302 到 127.0.0.1 时才用这个开关：默认自动在系统浏览器打开这首歌（整张专辑连播时同一首 45 秒内只开一个标签页）。",
      "type": "select",
      "options": [
        {
          "value": "on",
          "label": "用浏览器打开歌曲页（默认）"
        },
        {
          "value": "off",
          "label": "只在 App 里播（5nd 播不了）"
        }
      ]
    },
    {
      "key": "5nd-music.cookie",
      "label": "5nd音乐 · Cookie（可选）",
      "help": "一般不用填，插件已自带内置 Cookie。只有当内置 Cookie 失效（例如站点换了统计 Cookie 名）时，才用浏览器打开 www.5nd.com，从开发者工具里复制 mpge.5nd.com 请求的整条 Cookie 粘贴到这里，它会覆盖内置值。",
      "type": "text"
    },
    {
      "key": "33ve.cookie",
      "label": "闪闪音乐 · Session cookie (optional)",
      "help": "Only if the site's robot check keeps failing. Open www.33ve.com in a browser, pass the check, then copy the Cookie request header from the developer tools and paste it here.",
      "type": "password"
    },
    {
      "key": "mvmp3.cookie",
      "label": "无名音乐 · Session cookie (optional)",
      "help": "Only if the site's robot check keeps failing. Open www.mvmp3.com in a browser, pass the check, then copy the Cookie request header from the developer tools and paste it here.",
      "type": "password"
    },
    {
      "key": "jusic-room.houseId",
      "label": "一起听歌吧 · 房间 ID",
      "help": "默认 DEFAULT（公开的「一起听歌吧」）。首页第一屏底部的「打开房间列表」里有别的房间 ID，填到这里就换房间。",
      "type": "text"
    },
    {
      "key": "jusic-room.housePwd",
      "label": "一起听歌吧 · 房间密码（可选）",
      "help": "只对需要密码的房间有用；公开房间留空即可。",
      "type": "text"
    },
    {
      "key": "jusic-room.source",
      "label": "一起听歌吧 · 搜索音源",
      "help": "只影响搜索结果来自哪个曲库。搜到的条目是元数据，播放要等它进了房间队列。",
      "type": "select",
      "options": [
        {
          "value": "wy",
          "label": "网易云"
        },
        {
          "value": "qq",
          "label": "QQ 音乐"
        },
        {
          "value": "mg",
          "label": "咪咕"
        },
        {
          "value": "kw",
          "label": "酷我"
        },
        {
          "value": "kg",
          "label": "酷狗"
        }
      ]
    },
    {
      "key": "inmp3.localCache",
      "label": "IN音乐网 · 本地缓存播放",
      "help": "默认直接播放远程地址。填 1 改为用本机 ffmpeg 缓存到本地，适合源站要求 Referer 或中文路径。",
      "type": "text"
    },
    {
      "key": "inmp3.ffmpegPath",
      "label": "IN音乐网 · ffmpeg 路径",
      "help": "留空自动查找。",
      "type": "text"
    },
    {
      "key": "fangpiw.localCache",
      "label": "放屁网 · 本地缓存播放",
      "help": "默认直接播放远程地址。填 1 改为用本机 ffmpeg 缓存到本地，适合源站要求 Referer 或中文路径。",
      "type": "text"
    },
    {
      "key": "fangpiw.ffmpegPath",
      "label": "放屁网 · ffmpeg 路径",
      "help": "留空自动查找。",
      "type": "text"
    },
    {
      "key": "music7082.localCache",
      "label": "7082音乐网 · 本地缓存播放",
      "help": "默认直接播放远程地址。填 1 改为用本机 ffmpeg 缓存到本地，适合源站要求 Referer 或中文路径。",
      "type": "text"
    },
    {
      "key": "music7082.ffmpegPath",
      "label": "7082音乐网 · ffmpeg 路径",
      "help": "留空自动查找。",
      "type": "text"
    },
    {
      "key": "ting05.localCache",
      "label": "无忧音乐网 · 本地缓存播放",
      "help": "音频 CDN 对中文路径敏感，默认先用本机 ffmpeg 拉取并缓存为本地 m4a。填 0 改为直接返回远程地址。",
      "type": "text"
    },
    {
      "key": "ting05.ffmpegPath",
      "label": "无忧音乐网 · ffmpeg 路径",
      "help": "留空自动查找。",
      "type": "text"
    },
    {
      "key": "missevan-music.qtFallback",
      "label": "猫耳FM · 蜻蜓FM 同名回退",
      "help": "猫耳的单曲接口返回 Widevine 加密 HLS，第三方播放器解不了。开启后这类曲目会按节目名到蜻蜓FM 找同名节目顶上，播放列表标题会带「·蜻蜓FM」标明来源；关闭时直接报错，不偷换音源。",
      "type": "select",
      "options": [
        {
          "value": "off",
          "label": "关闭（默认）：只播音单里的明文音频"
        },
        {
          "value": "on",
          "label": "开启：被拒时按节目名找蜻蜓FM 同名音频"
        }
      ]
    },
    {
      "key": "85ting.transcode",
      "label": "85听书网 · 转码播放",
      "help": "85听书网的音频是 HE-AAC，应用自身解不了，要用 ffmpeg 转成 AAC-LC。播放器（3.0.94 起）自带 ffmpeg，不用装系统版。填 0 关闭转码，直接播放原地址（多数内容会报 SBR 错误）。",
      "type": "text"
    },
    {
      "key": "85ting.ffmpegPath",
      "label": "85听书网 · ffmpeg 路径",
      "help": "留空就先用播放器自带的 ffmpeg；要指定别的版本时填完整路径（Windows 例 C:\\ffmpeg\\bin\\ffmpeg.exe）。",
      "type": "text"
    },
    {
      "key": "yitingshu.transcode",
      "label": "易听书网 · 转码播放",
      "help": "部分音频为 HE-AAC，默认用本机 ffmpeg 转 AAC-LC。填 0 关闭。",
      "type": "text"
    },
    {
      "key": "yitingshu.ffmpegPath",
      "label": "易听书网 · ffmpeg 路径",
      "help": "留空自动查找。",
      "type": "text"
    },
    {
      "key": "ting99.transcode",
      "label": "99听书网 · 转码播放",
      "help": "部分音频为 HE-AAC，默认用本机 ffmpeg 转 AAC-LC。填 0 关闭。",
      "type": "text"
    },
    {
      "key": "ting99.ffmpegPath",
      "label": "99听书网 · ffmpeg 路径",
      "help": "留空自动查找。",
      "type": "text"
    },
    {
      "key": "qmtsw.transcode",
      "label": "我听评书网 · 转码播放",
      "help": "站点音频多为喜马拉雅 HE-AAC，应用自身解不了；默认用本机 ffmpeg 转 AAC-LC。填 0 关闭。",
      "type": "text"
    },
    {
      "key": "qmtsw.ffmpegPath",
      "label": "我听评书网 · ffmpeg 路径",
      "help": "留空自动查找，找不到时填完整路径。",
      "type": "text"
    }
